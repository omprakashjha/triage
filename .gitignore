# SPM
.build/
.swiftpm/
# Package.resolved IS committed: Package.swift pins only the 3 direct
# dependencies, while aws-sdk-swift pulls ~26 transitive ones whose versions
# are recorded nowhere else. Without this file two machines can resolve
# different SwiftNIO/Smithy versions.

# macOS
.DS_Store
*.swp
*.lock
profile

# Secrets (never commit)
credentials.json
GoogleService-Info.plist
*.p12
*.key

# App config with secrets
# NOTE: pattern must match Triage/Config/Secrets.swift, not just a root-level Config/
**/Config/Secrets.swift
Secrets.swift
